---
interface Props {
  href: string;
  arrow?: boolean;
  class?: string;
  [key: string]: any;
}

const { href, arrow = false, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['link split-hover', className]} {...rest}>
  {arrow && (
    <svg class="link-arrow shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  <slot />
</a>

<style>
  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: inherit;
  }
</style>
