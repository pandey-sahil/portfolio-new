---
// "Dithering" background — adapted from Paper Shaders
// https://shaders.paper.design/dithering, licensed Apache-2.0.
import type { DitheringOptions } from '../../scripts/dithering';

interface Props {
  id: string;
  class?: string;
  options?: DitheringOptions;
}

const defaultOptions: DitheringOptions = {
  colors: ['#1A1423', '#B75D69', '#EACDC2', '#FFF5EB'],
  timeSpeed: 1.43,
  scale: 1.26,
  intensity: 0.35,
  paramA: 0.28,
  warp: 0.0,
  detail: 1.82,
  contrast: 1.0,
  brightness: 0.0,
  saturation: 1.0,
  hue: 0.0,
  vignette: 0.0,
  blur: 0.0,
  grain: 0.04,
  seed: 4328.0,
  rotate: 0.0,
  drift: 0.32,
  oklab: 1.0,

  cursorStrength: 0.65,
  cursorRadius: 0.39,
};

const { id, class: className, options = {} } = Astro.props;
const mergedOptions = { ...defaultOptions, ...options };
---

<div id={id} class={className} data-dithering-options={JSON.stringify(mergedOptions)}></div>

<script>
  import { createDithering } from '../../scripts/dithering';

  document.querySelectorAll<HTMLElement>('[data-dithering-options]').forEach((container) => {
    if (container.dataset.ditheringInitialized) return;
    container.dataset.ditheringInitialized = 'true';
    const options = JSON.parse(container.dataset.ditheringOptions || '{}');
    createDithering(container, options);
  });
</script>
