---
import Container from '../shared/Container.astro';
import Eyebrow from '../shared/Eyebrow.astro';

const services = [
  {
    title: 'Web Design',
    description: 'Clean, conversion-focused layouts that put your product and message first.',
  },
  {
    title: 'Webflow Development',
    description: 'Fast, accessible, production-ready builds with clean, maintainable structure.',
  },
  {
    title: 'Motion & Interaction',
    description: 'Purposeful animation and micro-interactions that feel alive without slowing a site down.',
  },
];
---

<section class="section-services">
  <Container class="padding-section-large flex flex-col gap-[max(32px,4.444vw)]">
    <div>
      <Eyebrow>What I Do</Eyebrow>
      <h2 class="heading-style-h2 leading-none">Services</h2>
    </div>

    <div class="grid w-full grid-cols-1 gap-[max(16px,1.389vw)] md:grid-cols-3">
      {services.map((service, i) => (
        <div class="flex flex-col items-start gap-4 rounded-[32px] bg-[#1e1e1e] px-6 py-8">
          <span class="flex size-12 items-center justify-center rounded-full bg-white/10 font-geist text-sm text-white/70">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="heading-style-h4 text-white">{service.title}</p>
          <p class="font-geist text-sm font-light text-neutral-400">{service.description}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
